# Copie para .env.local (não versionado) e ajuste.

# Vazio em dev: o proxy do Vite encaminha /api pro backend (vite.config.ts).
VITE_API_URL=

# Keycloak — local: docker-compose (porta 8180); produção: instância no Coolify.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=viagem-legal
VITE_KEYCLOAK_CLIENT_ID=viagem-legal-frontend
